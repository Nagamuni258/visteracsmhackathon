<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RoadBump" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
    <style name="Theme.RoadBump.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/md_sys_color_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.RoadBump</item>
    </style>
    <style name="Theme.RoadBump.Map" parent="Theme.RoadBump">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>