# MongoDB Connection
MONGO_URI=mongodb://localhost:27017

# Firebase Admin (only needed for FCM notifications)
# Path to your Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# FCM Topics (optional, adjust as needed)
ADMIN_FCM_TOPIC=admin_alerts
NEARBY_USERS_FCM_TOPIC=hazard_alerts

# Server Port
PORT=5000